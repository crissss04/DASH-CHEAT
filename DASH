end

refreshPromptToggle = function()
	if instantPromptEnabled then
		promptToggleButton.Text = "Instant Prompt: ON"
		promptToggleButton.BackgroundColor3 = Color3.fromRGB(40, 170, 90)
	else
		promptToggleButton.Text = "Instant Prompt: OFF"
		promptToggleButton.BackgroundColor3 = Color3.fromRGB(190, 60, 60)

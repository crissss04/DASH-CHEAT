-- ====== AUTO SAVE ======
-- Config dikirim ke server (DataStore) 1.5 detik setelah perubahan terakhir.
local configReady = false    -- true setelah config berhasil dimuat dari server
local loadingConfig = false  -- true saat menerapkan config yang dimuat (jangan simpan ulang)
local saveToken = 0
local zoomDistance = 128 -- nilai asli diisi di bagian ZOOM OUT

local function buildConfig()
	return {
		dashSpeed = dashSpeed,
		dashEnabled = featureEnabled,
		infJump = infJumpEnabled,
		instantPrompt = instantPromptEnabled,
		zoom = zoomDistance,
	}
end

local function markDirty()
	if loadingConfig or not configReady then return end
	saveToken += 1
	local myToken = saveToken
	task.delay(1.5, function()
		if myToken ~= saveToken then return end -- ada perubahan lebih baru, tunggu yang itu
		local remote = ReplicatedStorage:FindFirstChild("DashConfigSave")
		if remote then
			remote:FireServer(buildConfig())
		end
	end)
end


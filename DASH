end

local function refreshSpeed()
	local alpha = (dashSpeed - minSpeed) / (maxSpeed - minSpeed)
	fill.Size = UDim2.new(alpha, 0, 1, 0)
	knob.Position = UDim2.new(alpha, 0, 0.5, 0)
	speedLabel.Text = "Kecepatan: " .. tostring(dashSpeed)
end

local function setSpeed(value)
	dashSpeed = math.clamp(math.floor(value + 0.5), minSpeed, maxSpeed)
	refreshSpeed()
	markDirty()
end

local function setFeature(on)
	featureEnabled = on
	if not on then stopDash() end
	refreshToggle()
	markDirty()
end

-- ====== ZOOM OUT ======
-- Mengatur CameraMaxZoomDistance (seberapa jauh kamera bisa di-zoom out dengan scroll/pinch)
zoomDistance = math.clamp(player.CameraMaxZoomDistance, zoomMinValue, zoomMaxValue)
local zoomUserSet = false                        -- true setelah zoom diatur lewat panel/config
local originalMinZoom = player.CameraMinZoomDistance
local slidingZoom = false

local function refreshZoom()
	local alpha = (zoomDistance - zoomMinValue) / (zoomMaxValue - zoomMinValue)
	zoomFill.Size = UDim2.new(alpha, 0, 1, 0)
	zoomKnob.Position = UDim2.new(alpha, 0, 0.5, 0)
	zoomLabel.Text = "Zoom Out: " .. tostring(zoomDistance)
end

local function setZoom(value)
	zoomDistance = math.clamp(math.floor(value + 0.5), zoomMinValue, zoomMaxValue)
	zoomUserSet = true
	player.CameraMaxZoomDistance = zoomDistance
	refreshZoom()
	markDirty()
end

local function updateZoomFromX(x)
	local alpha = math.clamp((x - zoomTrack.AbsolutePosition.X) / zoomTrack.AbsoluteSize.X, 0, 1)
	setZoom(zoomMinValue + alpha * (zoomMaxValue - zoomMinValue))
end

zoomHit.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		slidingZoom = true
		updateZoomFromX(input.Position.X)
	end
end)

zoomMinusButton.MouseButton1Click:Connect(function() setZoom(zoomDistance - 25) end)
zoomPlusButton.MouseButton1Click:Connect(function() setZoom(zoomDistance + 25) end)

-- Pertahankan zoom: script kendaraan/kamera game sering mereset batas zoom saat duduk di mobil.
-- Setiap batas zoom diubah script lain, nilai kita dipasang lagi.
local function enforceZoom()
	if not zoomUserSet then return end
	if player.CameraMaxZoomDistance ~= zoomDistance then
		player.CameraMaxZoomDistance = zoomDistance
	end
	-- Jika game mengunci jarak minimum (min = max) sehingga zoom tidak bisa digeser, kembalikan
	if player.CameraMinZoomDistance > originalMinZoom then
		player.CameraMinZoomDistance = originalMinZoom
	end
end

player:GetPropertyChangedSignal("CameraMaxZoomDistance"):Connect(enforceZoom)
player:GetPropertyChangedSignal("CameraMinZoomDistance"):Connect(enforceZoom)
RunService.RenderStepped:Connect(enforceZoom) -- jaga-jaga jika perubahan terjadi tanpa memicu event


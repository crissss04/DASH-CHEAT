local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ====== PENGATURAN ======
local dashSpeed = 100   -- kecepatan dash (studs/detik)
-- ========================

local humanoid, rootPart
local holding = false
local dashConn
local connections = {}

-- GUI tombol Dash
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "DashGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = playerGui

local dashButton = Instance.new("TextButton")
dashButton.Name = "DashButton"
dashButton.Size = UDim2.new(0, 100, 0, 50)
dashButton.Position = UDim2.new(1, -110, 1, -240)
dashButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
dashButton.TextColor3 = Color3.fromRGB(255, 255, 255)
dashButton.Text = "Dash"
dashButton.Font = Enum.Font.GothamBold
dashButton.TextSize = 24
dashButton.BorderSizePixel = 2
dashButton.BorderColor3 = Color3.fromRGB(0, 0, 0)
dashButton.BackgroundTransparency = 0.3
dashButton.Parent = screenGui

-- Mulai dash (saat Q / tombol ditahan)
local function startDash()
    if holding or not humanoid or not rootPart then return end
    holding = true

    dashButton.BackgroundTransparency = 0.7

    dashConn = RunService.Heartbeat:Connect(function()
        if not rootPart or not humanoid or humanoid.Health <= 0 then return end

        -- Arah: arah jalan, atau arah hadap karakter jika diam
        local dir = humanoid.MoveDirection
        if dir.Magnitude == 0 then
            local look = rootPart.CFrame.LookVector
            dir = Vector3.new(look.X, 0, look.Z)
            if dir.Magnitude == 0 then return end
            dir = dir.Unit
        end

        local v = rootPart.AssemblyLinearVelocity
        rootPart.AssemblyLinearVelocity = Vector3.new(dir.X * dashSpeed, v.Y, dir.Z * dashSpeed)
    end)
end

-- Berhenti dash (saat Q / tombol dilepas)
local function stopDash()
    holding = false
    dashButton.BackgroundTransparency = 0.3
    if dashConn then
        dashConn:Disconnect()
        dashConn = nil
    end
end

-- Setup karakter (dipanggil saat spawn / respawn)
local function setupCharacter(char)
    stopDash()
    for _, conn in ipairs(connections) do
        conn:Disconnect()
    end
    connections = {}

    humanoid = char:WaitForChild("Humanoid")
    rootPart = char:WaitForChild("HumanoidRootPart")

    -- Hentikan dash jika karakter mati
    table.insert(connections, humanoid.Died:Connect(stopDash))
end

-- Input tombol di layar (mobile / klik)
dashButton.MouseButton1Down:Connect(startDash)
dashButton.MouseButton1Up:Connect(stopDash)

-- Input keyboard: tahan Q = ON, lepas Q = OFF
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.Q then
        startDash()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Q then
        stopDash()
    end
end)

-- Setup karakter
player.CharacterAdded:Connect(setupCharacter)
if player.Character then
    setupCharacter(player.Character)
end

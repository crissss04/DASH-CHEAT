local sliding = false
local function updateSliderFromX(x)
	local alpha = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
	setSpeed(minSpeed + alpha * (maxSpeed - minSpeed))
end

sliderHit.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		sliding = true
		updateSliderFromX(input.Position.X)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then
		if sliding then updateSliderFromX(input.Position.X) end
		if slidingZoom then updateZoomFromX(input.Position.X) end
	end
end)

-- ====== INPUT KEYBOARD ======
UserInputService.InputBegan:Connect(function(input)
	-- gameProcessed sengaja TIDAK dipakai: kalau Q/P juga dipakai fitur lain
	-- (misalnya ProximityPrompt dengan tombol Q), Roblox menandainya "sudah diproses"
	-- dan dash tidak akan jalan. Yang diblokir hanya saat sedang mengetik di chat/TextBox.
	if UserInputService:GetFocusedTextBox() then return end

	if input.KeyCode == panelKey then
		panel.Visible = not panel.Visible   -- P: buka/tutup panel
	elseif input.KeyCode == dashKey then
		startDash()                         -- tahan Q: dash ON
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		sliding = false
		slidingZoom = false
	end
	if input.KeyCode == dashKey then
		stopDash()                          -- lepas Q: dash OFF
	end
end)

-- ====== INFINITY JUMP ======
-- JumpRequest aktif untuk tombol Space maupun tombol lompat di mobile
UserInputService.JumpRequest:Connect(function()
	if infJumpEnabled and humanoid and humanoid.Health > 0 then
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

-- ====== SETUP KARAKTER ======
local function setupCharacter(char)
	stopDash()
	for _, conn in ipairs(connections) do
		conn:Disconnect()
	end
	connections = {}

	humanoid = char:WaitForChild("Humanoid")
	rootPart = char:WaitForChild("HumanoidRootPart")

	-- Terapkan ulang zoom out (jaga-jaga kalau script kamera game mereset)
	player.CameraMaxZoomDistance = zoomDistance

	table.insert(connections, humanoid.Died:Connect(stopDash))
end

player.CharacterAdded:Connect(setupCharacter)
if player.Character then
	setupCharacter(player.Character)
end

-- Tampilan awal
refreshToggle()
refreshJumpToggle()
refreshPromptToggle()
refreshSpeed()
refreshZoom()

-- ====== MUAT CONFIG TERSIMPAN ======
task.spawn(function()
	local getFn = ReplicatedStorage:WaitForChild("DashConfigGet", 10)
	if not getFn then
		warn("[DashPanel] DashConfigGet tidak ditemukan. Pastikan DashConfigServer ada di ServerScriptService. Auto save nonaktif.")
		return
	end

	local ok, data = pcall(function()
		return getFn:InvokeServer()
	end)
	if not ok or type(data) ~= "table" then
		warn("[DashPanel] Gagal memuat config:", data)
		return
	end

	loadingConfig = true
	if type(data.dashSpeed) == "number" then setSpeed(data.dashSpeed) end
	if type(data.dashEnabled) == "boolean" then setFeature(data.dashEnabled) end
	if type(data.infJump) == "boolean" then
		infJumpEnabled = data.infJump
		refreshJumpToggle()
	end
	if type(data.instantPrompt) == "boolean" then setInstantPrompt(data.instantPrompt) end
	if type(data.zoom) == "number" then setZoom(data.zoom) end
	loadingConfig = false

	configReady = true -- mulai dari sini perubahan akan disimpan otomatis
end)

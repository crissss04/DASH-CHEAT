-- ====== LOGIKA DASH ======
local stopDash -- dideklarasikan dulu karena dipakai di dalam startDash

local function startDash()
	if not featureEnabled or holding or not humanoid or not rootPart then return end
	holding = true

	dashConn = RunService.Heartbeat:Connect(function()
		if not rootPart or not humanoid or humanoid.Health <= 0 then return end

		-- Pengaman: kalau Q sudah dilepas tapi event lepasnya terlewat, hentikan dash
		if not UserInputService:IsKeyDown(dashKey) then
			stopDash()
			return
		end

		local dir = humanoid.MoveDirection
		if dir.Magnitude == 0 then
			local look = rootPart.CFrame.LookVector
			dir = Vector3.new(look.X, 0, look.Z)
			if dir.Magnitude == 0 then return end
			dir = dir.Unit
		end

		local v = rootPart.AssemblyLinearVelocity
		rootPart.AssemblyLinearVelocity = Vector3.new(dir.X * dashSpeed, v.Y, dir.Z * dashSpeed)
	end)
end

stopDash = function()
	holding = false
	if dashConn then
		dashConn:Disconnect()
		dashConn = nil
	end
end

-- ====== INSTANT PROMPT ======
-- Membuat ProximityPrompt langsung aktif tanpa ditahan (HoldDuration = 0).
-- Nilai asli disimpan supaya bisa dikembalikan saat fitur dimatikan.
local originalHold = setmetatable({}, {__mode = "k"})
local refreshPromptToggle -- dideklarasikan dulu, diisi di bagian UPDATE TAMPILAN

local function applyInstant(prompt)
	if originalHold[prompt] == nil then
		originalHold[prompt] = prompt.HoldDuration
	end
	prompt.HoldDuration = 0
end

ProximityPromptService.PromptShown:Connect(function(prompt)
	if instantPromptEnabled then
		applyInstant(prompt)
	end
end)

local function setInstantPrompt(on)
	instantPromptEnabled = on
	if on then
		for _, obj in ipairs(workspace:GetDescendants()) do
			if obj:IsA("ProximityPrompt") then
				applyInstant(obj)
			end
		end
	else
		for prompt, duration in pairs(originalHold) do
			if prompt.Parent then
				prompt.HoldDuration = duration
			end
			originalHold[prompt] = nil
		end
	end
	refreshPromptToggle()
	markDirty()
end

